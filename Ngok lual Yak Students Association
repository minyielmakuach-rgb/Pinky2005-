<!-- HIDDEN ADMIN PANEL -->
<div id="adminPanel"><div id="adminBox">
<h2>Admin Login</h2>
<div id="loginBox"><input id="email" placeholder="Admin Email"><input id="pass" type="password" placeholder="Password"><button onclick="adminLogin()" style="width:100%;padding:12px;background:#1e3a8a;color:#fff;border-radius:8px;font-weight:800;margin-top:8px">Login</button><button onclick="closeAdmin()" style="width:100%;padding:12px;background:#eee;border-radius:8px;margin-top:8px">Close</button></div>
<div id="uploadBox" style="display:none"><h3>Upload New Photo</h3><input type="file" id="file" accept="image/*"><input id="caption" placeholder="Caption"><button onclick="uploadPhoto()" style="width:100%;padding:12px;background:#1e3a8a;color:#fff;border-radius:8px;font-weight:800;margin-top:8px">Upload to Website</button><p id="status" style="margin-top:10px"></p><button onclick="adminLogout()" style="width:100%;padding:12px;background:#b91c1c;color:#fff;border-radius:8px;margin-top:15px">Logout</button></div>
</div></div>

<script>
const db=firebase.firestore(), storage=firebase.storage(), auth=firebase.auth();

// PUBLIC GALLERY - Loads automatically
db.collection('photos').orderBy('created','desc').onSnapshot(snap=>{
  const g=document.getElementById('galleryGrid'); g.innerHTML='';
  if(snap.empty){ g.innerHTML='<div>No photos yet. Admin can upload via?admin</div>'; return; }
  snap.forEach(doc=>{
    const p=doc.data();
    g.innerHTML+=`<div style="background-image:url('${p.url}')"><span style="background:#000a;color:#fff;padding:3px 7px;border-radius:20px;font-size:11px">${p.caption||''}</span></div>`;
  });
});

// ADMIN LOGIC - Only shows when?admin in URL or triple-click logo
function showAdmin(){ document.getElementById('adminPanel').style.display='block'; }
function closeAdmin(){ document.getElementById('adminPanel').style.display='none'; history.replaceState({},'',location.pathname); }
if(location.search.includes('admin')) showAdmin();

function adminLogin(){ auth.signInWithEmailAndPassword(email.value,pass.value).then(()=>{loginBox.style.display='none';uploadBox.style.display='block';}).catch(e=>alert(e.message)) }
function adminLogout(){ auth.signOut().then(()=>location.reload()) }
auth.onAuthStateChanged(u=>{ if(u){loginBox.style.display='none';uploadBox.style.display='block'; showAdmin();}});

async function uploadPhoto(){
  const f=file.files[0]; if(!f) return alert('Choose photo');
  status.innerText='Uploading...';
  const ref=storage.ref('gallery/'+Date.now()+'_'+f.name);
  await ref.put(f);
  const url=await ref.getDownloadURL();
  await db.collection('photos').add({url,caption:caption.value||'NLYSAUHI',created:Date.now()});
  status.innerText='✅ Photo is now LIVE on website!'; file.value=''; caption.value='';
}
</script>
